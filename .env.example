# Local development defaults. Never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roleway
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Cloudflare Turnstile site key (public).
# Leave blank for the development bypass when CAPTCHA is disabled in local Supabase.
# To exercise Turnstile locally, use Cloudflare's always-pass test site key below and
# configure its matching public test secret in local Supabase Auth CAPTCHA settings:
#   site key:   1x00000000000000000000AA
#   test secret: 1x0000000000000000000000000000000AA
# Production must use the hostname-restricted production site key in Vercel and its
# matching secret only in Supabase Auth; never put a Turnstile secret in NEXT_PUBLIC_*.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Base64-encoded 32-byte AES key for encrypted user-supplied AI credentials.
# Generate with: openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEY=

# Stable base64-encoded 32-byte key for Server Actions when self-hosting multiple instances.
# Generate independently with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
