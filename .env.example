# Project setup — app variables live in apps/web/.env.example

# Resend SMTP — setup only, domain-restricted sending key
RESEND_API_KEY=
SMTP_FROM_EMAIL=roleway@vanajvanguardia.tech

# Supabase management — setup only
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
DATABASE_URL=

# Supabase Studio AI — optional
OPENAI_API_KEY=

# Google OAuth — configure client ID/secret directly in Supabase Auth.
# Keep Skip nonce checks OFF (false) in the Supabase Google provider.
# Copy the app flag from apps/web/.env.example into apps/web/.env.local
# (or Vercel) after following docs/GOOGLE_AUTH.md.
