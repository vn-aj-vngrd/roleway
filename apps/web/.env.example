# App
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in beta — enable after provider setup in docs/GOOGLE_AUTH.md
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Google OAuth client ID and secret belong in Supabase Auth, not the app.

# Turnstile — required in production; secret belongs in Supabase Auth
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# AI credentials — generate with: openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEY=

# Self-hosting — optional, independent 32-byte base64 key
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Browser tests — optional; admin uses disposable Admin API fixtures
E2E_AUTH_MODE=
ROLEWAY_TEST_OPENROUTER_KEY=
